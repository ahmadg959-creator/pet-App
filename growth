    <script>
        // This function will wait until the `tailwind` object is loaded before configuring it.
        // This fixes a potential race condition error: "tailwind is not defined".
        function configureTailwind() {
            if (typeof tailwind !== 'undefined') {
                // Custom Tailwind theme colors
                tailwind.config = {
                    theme: {
                        extend: {
                            colors: {
                                'beige': '#F5F5DC',
                                'sky-blue': '#87CEEB',
                                'teal-accent': '#008080',
                            }
                        }
                    }
                }
            } else {
                // If tailwind isn't loaded yet, try again in 50ms.
                setTimeout(configureTailwind, 50);
            }
        }
        // Start the configuration attempt.
        configureTailwind();
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc; /* slate-50 */
        }
        /* Adding a subtle transition for page content */
        .page-content, .pet-view {
            transition: opacity 0.3s ease-in-out;
        }

        /* Paw Animation Styling for Profile Icon */
        #profile-link-desktop:hover .paw-pad { animation: paw-press 1.2s infinite cubic-bezier(0.4, 0, 0.2, 1); }
        #profile-link-desktop:hover .toe-1 { animation-delay: 0s; }
        #profile-link-desktop:hover .toe-2 { animation-delay: 0.1s; }
        #profile-link-desktop:hover .toe-3 { animation-delay: 0.2s; }
        #profile-link-desktop:hover .toe-4 { animation-delay: 0.3s; }
        #profile-link-desktop:hover .main-pad { animation-delay: 0.4s; }

        @keyframes paw-press {
            0%, 50%, 100% { fill: #718096; transform: scale(1); }
            25% { fill: #3b82f6; transform: scale(1.1); }
        }
        
        /* Paw Hover for Nav Links */
        .nav-button { position: relative; }
        .nav-button::after {
            content: '🐾';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%) scale(0);
            opacity: 0;
            transition: transform 0.3s ease, opacity 0.3s ease;
            font-size: 1.2rem;
            color: #3b82f6;
        }
        .nav-button.bg-blue-500::after,
        .nav-button:hover::after {
            transform: translateX(-50%) scale(1);
            opacity: 1;
        }

        /* Loading Spinner */
        .loader {
            border: 4px solid #f3f3f3; /* Light grey */
            border-top: 4px solid #3b82f6; /* Blue */
            border-radius: 50%;
            width: 32px;
            height: 32px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Styling for active tab */
        .tab-active {
            border-bottom-color: #3b82f6; /* blue-500 */
            color: #3b82f6;
        }
        
        /* Styling for reminder filter tabs */
        .reminder-filter-tab {
            @apply py-2 px-4 font-medium text-sm rounded-full transition-colors duration-200;
        }
        .reminder-filter-tab-active {
            @apply bg-blue-500 text-white;
        }
        .reminder-filter-tab-inactive {
            @apply text-slate-600 hover:bg-slate-100;
        }

        /* Modal transition */
        .modal-enter {
            opacity: 0;
            transform: scale(0.95);
        }
        .modal-enter-active {
            opacity: 1;
            transform: scale(1);
            transition: opacity 200ms ease-out, transform 200ms ease-out;
        }
        .modal-leave {
            opacity: 1;
            transform: scale(1);
        }
        .modal-leave-active {
            opacity: 0;
            transform: scale(0.95);
            transition: opacity 200ms ease-in, transform 200ms ease-in;
        }
    </style>
