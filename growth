                            <!-- Filter Tabs -->
                            <div class="mb-4 bg-slate-100 p-1.5 rounded-full flex flex-wrap items-center">
                                <button class="reminder-filter-tab reminder-filter-tab-active" data-filter="Upcoming">Upcoming</button>
                                <button class="reminder-filter-tab reminder-filter-tab-inactive" data-filter="All">All</button>
                                <button class="reminder-filter-tab reminder-filter-tab-inactive" data-filter="Completed">Completed</button>
                                <button class="reminder-filter-tab reminder-filter-tab-inactive" data-filter="Missed">Missed</button>
                            </div>

                            <!-- Reminders List -->
                            <div id="reminders-list-container" class="space-y-4">
                                <!-- Reminders will be injected here -->
                            </div>
                            <p id="no-reminders-message" class="text-slate-500 text-center py-12 hidden">
                                <span class="text-4xl mb-4 block">🗓️</span>
                                No reminders here.
                            </p>
                        </div>

                        <div id="tab-gallery" class="tab-content hidden bg-white rounded-2xl shadow-lg p-6 md:p-8"><p class="text-center text-slate-500">Editing for Media Gallery coming soon!</p></div>
                    </div>
                `;
                petDetailView.classList.remove('hidden');

                // Add event listeners for new elements
                attachPetDetailEventListeners(currentPetForReminders);
            }

            function attachPetDetailEventListeners(pet) {
                 document.getElementById('back-to-dashboard-btn').addEventListener('click', showDashboard);
                
                // Toggle form visibility
                petDetailView.querySelectorAll('.toggle-form-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const formId = e.currentTarget.dataset.form;
                        const form = document.getElementById(formId);
                        form.classList.toggle('hidden');
                        // If it's the vaccine form, reset it for "Add" mode
                        if (formId === 'add-vaccination-form') {
                             resetVaccineForm();
                        }
                        if (formId === 'add-growth-form') {
                             resetGrowthForm();
                        }
                    });
                });

                // Tab switching logic
                const tabs = petDetailView.querySelectorAll('.pet-tab');
                const tabContents = petDetailView.querySelectorAll('.tab-content');
                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        tabs.forEach(t => t.classList.remove('tab-active') || t.classList.add('text-slate-500', 'hover:text-slate-700'));
                        tab.classList.add('tab-active');
                        tab.classList.remove('text-slate-500', 'hover:text-slate-700');
                        tabContents.forEach(content => content.classList.add('hidden'));
                        document.getElementById(`tab-${tab.dataset.tab}`).classList.remove('hidden');
                    });
                });

                // --- Specific Handlers for Health Tab ---
                renderVaccinationTable(pet);
                renderAllergyList(pet);

                // --- Specific Handlers for Growth Tab ---
                renderGrowthLog(pet);
                renderGrowthChart(pet); // Initial render

                // --- Specific Handlers for Reminders Tab ---
                currentReminderFilter = 'Upcoming'; // Reset filter on view
                renderReminders(pet); // Initial render
                
                // Add listener for the main "+ Add Reminder" button in the tab
                const addReminderMainBtn = document.getElementById('add-reminder-main-btn');
                if (addReminderMainBtn) {
                    addReminderMainBtn.addEventListener('click', (e) => {
                        const petId = parseInt(e.currentTarget.dataset.petId);
                        showReminderModal(petId);
                    });
                }

                // Add listeners for filter tabs
                const reminderFilterTabs = petDetailView.querySelectorAll('.reminder-filter-tab');
                reminderFilterTabs.forEach(tab => {
                    tab.addEventListener('click', (e) => {
                        currentReminderFilter = e.currentTarget.dataset.filter;
                        // Update styles
                        reminderFilterTabs.forEach(t => {
                            t.classList.remove('reminder-filter-tab-active');
                            t.classList.add('reminder-filter-tab-inactive');
                        });
                        e.currentTarget.classList.add('reminder-filter-tab-active');
                        e.currentTarget.classList.remove('reminder-filter-tab-inactive');
                        // Re-render the list
                        renderReminders(pet);
                    });
                });

                // Add event delegation for reminder card buttons
                const remindersListContainer = document.getElementById('reminders-list-container');
                if (remindersListContainer) {
                    remindersListContainer.addEventListener('click', (e) => {
                        const completeBtn = e.target.closest('.complete-reminder-btn');
                        const editBtn = e.target.closest('.edit-reminder-btn');
                        const deleteBtn = e.target.closest('.delete-reminder-btn');

                        if (completeBtn) {
                            const reminderId = parseInt(completeBtn.dataset.reminderId);
                            const reminder = pet.reminders.find(r => r.id === reminderId);
                            
                            if (reminder) {
                                // Mark current one as completed
                                reminder.status = 'completed';

                                // Handle repeating reminders
                                if (reminder.repeat !== 'None') {
                                    const newReminder = { ...reminder }; // Create a copy
                                    newReminder.id = Date.now(); // Assign a new unique ID
                                    newReminder.status = 'pending'; // Reset status

                                    // Calculate the next date
                                    const currentDate = new Date(reminder.date + 'T' + (reminder.time || '00:00'));
                                    if (reminder.repeat === 'Daily') {
                                        currentDate.setDate(currentDate.getDate() + 1);
                                    } else if (reminder.repeat === 'Weekly') {
                                        currentDate.setDate(currentDate.getDate() + 7);
                                    } else if (reminder.repeat === 'Monthly') {
                                        // This is a simplified month-add, works for most cases
                                        currentDate.setMonth(currentDate.getMonth() + 1);
                                    }
                                    
                                    newReminder.date = currentDate.toISOString().split('T')[0]; // Format as YYYY-MM-DD
                                    pet.reminders.push(newReminder); // Add the new reminder
                                }

                                savePets();
                                renderReminders(pet);
                            }
                        }

                        if (editBtn) {
                            const reminderId = parseInt(editBtn.dataset.reminderId);
                            showReminderModal(pet.id, reminderId);
                        }

                        if (deleteBtn) {
                            const reminderId = parseInt(deleteBtn.dataset.reminderId);
                            showDeleteConfirmation('Are you sure you want to delete this reminder?', () => {
                                pet.reminders = pet.reminders.filter(r => r.id !== reminderId);
                                savePets();
                                renderReminders(pet);
                            });
                        }
                    });
                }

                // --- AI Reminder Suggestion Logic ---
                const suggestRemindersBtn = document.getElementById('suggest-reminders-btn');
                const aiSuggestionCard = document.getElementById('ai-suggestion-card');
                const aiSuggestionLoader = document.getElementById('ai-suggestion-loader');
                const aiSuggestionContent = document.getElementById('ai-suggestion-content');
                const aiSuggestionActions = document.getElementById('ai-suggestion-actions');
                const addSelectedRemindersBtn = document.getElementById('add-selected-reminders-btn');

                if (suggestRemindersBtn) {
                    suggestRemindersBtn.addEventListener('click', async (e) => {
                        const btn = e.currentTarget;
                        btn.disabled = true;
                        aiSuggestionCard.classList.remove('hidden');
                        aiSuggestionLoader.classList.remove('hidden');
                        aiSuggestionContent.innerHTML = '';
                        aiSuggestionActions.classList.add('hidden');

                        // Prepare data for the prompt
                        const healthSummary = `Vaccinations: ${pet.health.vaccinations.length > 0 ? pet.health.vaccinations.map(v => `${v.name} on ${v.date}`).join(', ') : 'None.'}`;
                        const growthSummary = `Growth: ${pet.growth.length > 0 ? `Last entry on ${pet.growth[pet.growth.length - 1].date} was ${pet.growth[pet.growth.length - 1].weight_kg}kg.` : 'No data.'}`;
                        const existingReminders = `Existing Reminders: ${pet.reminders.length > 0 ? pet.reminders.filter(r => r.status === 'pending').map(r => r.title).join(', ') : 'None pending.'}`;

                        const systemInstruction = `You are a helpful pet care assistant. Analyze the pet's info and records. Suggest 3-5 concise, actionable reminders. Format EACH reminder as a single line starting with a dash. Example: - Schedule annual vet checkup. Do not use markdown or numbering.`;
                        const userPrompt = `My pet is ${pet.name}, a ${calculateAge(pet.dob)} year old ${pet.breed}. 
                        ${healthSummary}. 
                        ${growthSummary}. 
                        ${existingReminders}. 
                        Please suggest a few important reminders.`;

                        const suggestionsText = await callGeminiAPI(userPrompt, systemInstruction);

                        aiSuggestionLoader.classList.add('hidden');
                        btn.disabled = false;

                        if (suggestionsText.includes('-')) {
                            const suggestions = suggestionsText.split('\n').filter(s => s.startsWith('-')).map(s => s.substring(1).trim());
                            
                            aiSuggestionContent.innerHTML = suggestions.map((s, index) => `
                                <label class="flex items-center space-x-3 p-2 rounded-lg hover:bg-purple-100 transition-colors">
                                    <input type="checkbox" class="ai-suggestion-checkbox h-4 w-4 text-purple-600 focus:ring-purple-500 border-slate-300 rounded" data-title="${s}" value="${index}">
                                    <span class="text-purple-900">${s}</span>
                                </label>
                            `).join('');
                            
                            aiSuggestionActions.classList.remove('hidden');
                        } else {
                            aiSuggestionContent.innerHTML = `<p class="text-purple-800">${suggestionsText}</p>`;
                            aiSuggestionActions.classList.add('hidden');
                        }
                    });
                }

                if (addSelectedRemindersBtn) {
                    addSelectedRemindersBtn.addEventListener('click', () => {
                        const checkedBoxes = aiSuggestionContent.querySelectorAll('.ai-suggestion-checkbox:checked');
                        if (checkedBoxes.length === 0) {
                            showMessage("Please select at least one suggestion to add.");
                            return;
                        }

                        const today = new Date();
                        const defaultDate = new Date(today.setDate(today.getDate() + 7)).toISOString().split('T')[0]; // One week from now

                        checkedBoxes.forEach(box => {
                            const title = box.dataset.title;
                            
                            // Simple type inference
                            let type = 'Other';
                            if (title.toLowerCase().includes('vet') || title.toLowerCase().includes('checkup') || title.toLowerCase().includes('vaccin')) type = 'Vet';
                            if (title.toLowerCase().includes('groom')) type = 'Grooming';
                            if (title.toLowerCase().includes('medica') || title.toLowerCase().includes('pill')) type = 'Medication';
                            if (title.toLowerCase().includes('weigh') || title.toLowerCase().includes('growth')) type = 'Growth';

                            const newReminder = {
                                id: Date.now() + Math.random(), // Add random to avoid collision in loop
                                title: title,
                                type: type,
                                date: defaultDate,
                                time: '09:00',
                                repeat: 'None',
                                notes: 'Generated by AI suggestion.',
                                status: 'pending'
                            };
                            pet.reminders.push(newReminder);
                        });

                        savePets();
                        renderReminders(pet);
                        showToast(`Added ${checkedBoxes.length} new reminder(s)!`);
                        
                        // Clear and hide AI card
                        aiSuggestionContent.innerHTML = '';
                        aiSuggestionActions.classList.add('hidden');
                        aiSuggestionCard.classList.add('hidden');
                    });
                }


                // Re-attach listeners within the health tab specifically
                const healthTab = document.getElementById('tab-health');
                healthTab.addEventListener('click', (e) => {
                    // Save/Update Vaccine
                    if (e.target.id === 'save-vaccine-btn') {
                        const index = document.getElementById('editing-vaccine-index').value;
                        const record = {
                            id: index !== '' ? pet.health.vaccinations[index].id : Date.now(),
                            name: document.getElementById('new-vaccine-name').value,
                            brand: document.getElementById('new-vaccine-brand').value,
                            date: document.getElementById('new-vaccine-date').value,
                            clinic: document.getElementById('new-vaccine-clinic').value,
                        };

                        if (record.name && record.date) {
                            if (index !== '') { // Editing
                                pet.health.vaccinations[index] = record;
                            } else { // Adding
                                pet.health.vaccinations.push(record);

                                // --- ADDED: Create automatic reminder for next year ---
                                const vaccineDate = new Date(record.date + 'T09:00:00'); // Use 9am
                                vaccineDate.setFullYear(vaccineDate.getFullYear() + 1);
                                const reminderDate = vaccineDate.toISOString().split('T')[0];

                                const newReminder = {
                                    id: Date.now() + 1,
                                    title: `${record.name} Booster`,
                                    type: 'Vet',
                                    date: reminderDate,
                                    time: '09:00',
                                    repeat: 'None',
                                    notes: `Follow-up for ${record.name} vaccination received on ${record.date}.`,
                                    status: 'pending'
                                };
                                if (!pet.reminders) pet.reminders = [];
                                pet.reminders.push(newReminder);
                                showToast('Vet reminder added for next year!');
                                // --- END ADDED ---
                            }
                            savePets(); // Save data
                            renderVaccinationTable(pet);
                            renderReminders(pet); // Re-render reminders list
                            document.getElementById('add-vaccination-form').classList.add('hidden');
                        } else {
                            // Using custom modal instead of alert
                            showMessage('Vaccine Name and Date are required.');
                        }
                    }
                    // Cancel Vaccine Edit
                    if (e.target.id === 'cancel-vaccine-edit-btn') {
                        document.getElementById('add-vaccination-form').classList.add('hidden');
                        resetVaccineForm();
                    }
                    // Edit Vaccine
                    if (e.target.closest('.edit-vaccine-btn')) {
                        const btn = e.target.closest('.edit-vaccine-btn');
                        const index = btn.dataset.index;
                        const vaccine = pet.health.vaccinations[index];
                        
                        document.getElementById('add-vaccination-form').classList.remove('hidden');
                        document.getElementById('vaccine-form-title').textContent = 'Edit Vaccination Record';
                        document.getElementById('editing-vaccine-index').value = index;
                        
                        document.getElementById('new-vaccine-name').value = vaccine.name;
                        document.getElementById('new-vaccine-brand').value = vaccine.brand || '';
                        document.getElementById('new-vaccine-date').value = vaccine.date;
                        document.getElementById('new-vaccine-clinic').value = vaccine.clinic || '';
                    }
                    // Delete Vaccine
                    if (e.target.closest('.delete-vaccine-btn')) {
                        const btn = e.target.closest('.delete-vaccine-btn');
                        const index = btn.dataset.index;
                        showDeleteConfirmation('Are you sure you want to delete this vaccination record?', () => {
                           pet.health.vaccinations.splice(index, 1);
                           savePets(); // Save data
                           renderVaccinationTable(pet);
                        });
                    }
                     // Save Allergy
                    if (e.target.matches('.add-item-btn[data-type="allergies"]')) {
                        const name = document.getElementById('new-allergy-name').value;
                        if (name) {
                            pet.health.allergies.push(name);
                            savePets(); // Save data
                            renderAllergyList(pet);
                            document.getElementById('new-allergy-name').value = '';
                            document.getElementById('add-allergy-form').classList.add('hidden');
                        }
                    }
                    // Delete Allergy
                    if (e.target.closest('.delete-allergy-btn')) {
                        const btn = e.target.closest('.delete-allergy-btn');
                        const index = btn.dataset.index;
                        showDeleteConfirmation('Are you sure you want to remove this allergy?', () => {
                            pet.health.allergies.splice(index, 1);
                            savePets(); // Save data
                            renderAllergyList(pet);
                        });
                    }
                });

                // --- Event Listeners for Growth Tab ---
                const growthTab = document.getElementById('tab-growth');
                if (growthTab) {
                    // AI Growth Analysis Button
                    const analyzeGrowthBtn = document.getElementById('analyze-growth-btn');
                    if (analyzeGrowthBtn) {
                        analyzeGrowthBtn.addEventListener('click', async (event) => {
                            const btn = event.currentTarget; // Store reference
                            if (!btn) return;

                            const card = document.getElementById('growth-analysis-card');
                            const loader = document.getElementById('growth-analysis-loader');
                            const content = document.getElementById('growth-analysis-content');

                            if (!pet.growth || pet.growth.length < 2) {
                                showMessage("Not enough growth data to analyze. Please add at least two entries.");
                                return;
                            }

                            card.classList.remove('hidden');
                            loader.classList.remove('hidden');
                            content.innerHTML = '';
                            btn.disabled = true; // Use stored reference

                            const systemInstruction = "You are a friendly veterinary assistant. Analyze the pet's growth data (date, weight in kg) and provide a one-paragraph summary (under 75 words) about their weight trend. Conclude with one piece of friendly, general advice on diet or exercise. Address the owner directly.";
                            
                            const growthDataString = pet.growth
                                .sort((a, b) => new Date(a.date) - new Date(b.date)) // Ensure data is chronological
                                .map(g => `Date: ${g.date}, Weight: ${g.weight_kg || 'N/A'} kg`)
                                .join('; ');
                            
                            const userPrompt = `My pet is ${pet.name}, a ${pet.breed}. Here is their growth data: [${growthDataString}]. Please analyze their weight trend and provide a summary and one piece of advice.`;

                            const analysisText = await callGeminiAPI(userPrompt, systemInstruction);

                            content.textContent = analysisText;
                            loader.classList.add('hidden');
                            btn.disabled = false; // Use stored reference
                        });
                    }

                    // Growth Tab CRUD operations
                    growthTab.addEventListener('click', (e) => {
                        // Save/Update Growth Entry
                        if (e.target.id === 'save-growth-btn') {
                            const index = document.getElementById('editing-growth-index').value;
                            const record = {
                                id: index !== '' ? pet.growth[index].id : Date.now(),
                                date: document.getElementById('new-growth-date').value,
                                weight_kg: parseFloat(document.getElementById('new-growth-weight').value) || null,
                                height_cm: parseFloat(document.getElementById('new-growth-height').value) || null,
                                notes: document.getElementById('new-growth-notes').value,
                                photo: document.getElementById('growth-photo-preview').src,
                            };

                            if (record.date && (record.weight_kg || record.height_cm)) {
                                if (index !== '') { // Editing
                                    pet.growth[index] = record;
                                } else { // Adding
                                    pet.growth.push(record);
                                    
                                    // --- UPDATED: Create automatic reminder with new structure ---
                                    const entryDate = new Date(record.date); // Use entry date
                                    entryDate.setDate(entryDate.getDate() + 30); // Add 30 days
                                    const reminderDate = entryDate.toISOString().split('T')[0]; // Format as 'YYYY-MM-DD'
                                    
                                    const newReminder = {
                                        id: Date.now() + 1,
                                        title: 'Next Weigh-in',
                                        type: 'Growth',
                                        date: reminderDate,
                                        time: '09:00', // Default time
                                        repeat: 'None',
                                        notes: `Next weigh-in for ${pet.name}.`,
                                        status: 'pending'
                                    };
                                    
                                    if (!pet.reminders) { pet.reminders = []; } // Ensure reminders array exists
                                    pet.reminders.push(newReminder);
                                    showToast('Growth reminder added for 30 days!');
                                    // --- END UPDATED ---
                                }
                                savePets(); // Save data
                                renderGrowthLog(pet);
                                renderGrowthChart(pet);
                                renderReminders(pet); // Also update reminder list
                                document.getElementById('add-growth-form').classList.add('hidden');
                                resetGrowthForm();
                            } else {
                                showMessage('Date and at least one measurement (Weight or Height) are required.');
                            }
                        }

                        // Cancel Growth Edit
                        if (e.target.id === 'cancel-growth-edit-btn') {
                            document.getElementById('add-growth-form').classList.add('hidden');
                            resetGrowthForm();
                        }

                        // Edit Growth Entry
                        if (e.target.closest('.edit-growth-btn')) {
                            const btn = e.target.closest('.edit-growth-btn');
                            const index = btn.dataset.index;
                            const entry = pet.growth[index];
                            
                            document.getElementById('add-growth-form').classList.remove('hidden');
                            document.getElementById('growth-form-title').textContent = 'Edit Growth Entry';
                            document.getElementById('editing-growth-index').value = index;
                            
                            document.getElementById('new-growth-date').value = entry.date;
                            document.getElementById('new-growth-weight').value = entry.weight_kg || '';
                            document.getElementById('new-growth-height').value = entry.height_cm || '';
                            document.getElementById('new-growth-notes').value = entry.notes || '';
                            document.getElementById('growth-photo-preview').src = entry.photo || 'https://placehold.co/64x64/e2e8f0/94a3b8?text=Photo';
                        }

                        // Delete Growth Entry
                        if (e.target.closest('.delete-growth-btn')) {
                            const btn = e.target.closest('.delete-growth-btn');
                            const index = btn.dataset.index;
                            showDeleteConfirmation('Are you sure you want to delete this growth entry?', () => {
                                pet.growth.splice(index, 1);
                                savePets(); // Save data
                                renderGrowthLog(pet);
                                renderGrowthChart(pet);
                            });
                        }
                    });
                }

                 // AI Bio Generator
                 document.getElementById('generate-bio-btn').addEventListener('click', async (event) => {
                    // FIX: Store event.currentTarget in a variable before await
                    const clickedButton = event.currentTarget;
                    if (!clickedButton) return; // Guard if button not found

                    const bioContainer = document.getElementById('pet-bio-container');
                    const bioLoader = document.getElementById('pet-bio-loader');
                    const bioContent = document.getElementById('pet-bio-content');

                    bioContainer.classList.remove('hidden');
                    bioLoader.classList.remove('hidden');
                    bioContent.innerHTML = '';
                    clickedButton.disabled = true; // Use stored reference

                    const systemInstruction = "You are a creative pet biographer. Write a short, fun, and heartwarming personality bio for a pet in the first person (from the pet's perspective). The bio should be one paragraph and capture a unique personality.";
                    const userPrompt = `My name is ${pet.name}, I'm a ${calculateAge(pet.dob)} year old ${pet.breed}. Write my personality bio.`;
                    
                    const bioText = await callGeminiAPI(userPrompt, systemInstruction);

                    bioContent.textContent = bioText;
                    bioLoader.classList.add('hidden');
                    
                    // FIX: Use the stored variable, which is safe after await
                    if (clickedButton) {
                        clickedButton.disabled = false;
                    }
                });
            }

            function renderVaccinationTable(pet) {
                const tableBody = document.getElementById('vaccination-table').querySelector('tbody');
                const noRecordsMsg = document.getElementById('no-vaccinations-message');
                tableBody.innerHTML = '';

                if (!pet.health.vaccinations || pet.health.vaccinations.length === 0) {
                    noRecordsMsg.classList.remove('hidden');
                    document.getElementById('vaccination-table').classList.add('hidden');
                } else {
                    noRecordsMsg.classList.add('hidden');
                    document.getElementById('vaccination-table').classList.remove('hidden');
                    pet.health.vaccinations.forEach((v, index) => {
                        const ageAtVaccination = calculateAgeAtDate(pet.dob, v.date);
                        const row = `
                            <tr class="bg-white border-b hover:bg-slate-50">
                                <td class="px-4 py-3 font-medium text-slate-900">${index + 1}</td>
                                <td class="px-4 py-3">${v.date}</td>
                                <td class="px-4 py-3">${ageAtVaccination}</td>
                                <td class="px-4 py-3">${v.name} / ${v.brand || 'N/A'}</td>
                                <td class="px-4 py-3">${v.clinic || 'N/A'}</td>
                                <td class="px-4 py-3 text-right">
                                    <button class="edit-vaccine-btn font-medium text-blue-600 hover:underline mr-3" data-index="${index}">Edit</button>
                                    <button class="delete-vaccine-btn font-medium text-red-600 hover:underline" data-index="${index}">Delete</button>
                                </td>
                            </tr>
                        `;
                        tableBody.innerHTML += row;
                    });
                }
            }
            
            function resetVaccineForm(){
                const form = document.getElementById('add-vaccination-form');
                if (form && typeof form.reset === 'function') {
                    form.reset();
                }
                const editingIndex = document.getElementById('editing-vaccine-index');
                if (editingIndex) {
                    editingIndex.value = '';
                }
                const formTitle = document.getElementById('vaccine-form-title');
                if (formTitle) {
                    formTitle.textContent = 'Add New Vaccination';
                }
            }

            function renderAllergyList(pet) {
                const listContainer = document.getElementById('allergy-list');
                const noRecordsMsg = document.getElementById('no-allergies-message');
                listContainer.innerHTML = '';
                if(!pet.health.allergies || pet.health.allergies.length === 0) {
                    noRecordsMsg.classList.remove('hidden');
                } else {
                    noRecordsMsg.classList.add('hidden');
                    pet.health.allergies.forEach((a, index) => {
                        listContainer.innerHTML += `
                            <span class="bg-red-100 text-red-700 text-sm font-medium px-3 py-1 rounded-full flex items-center gap-2">
                                ${a}
                                <button class="delete-allergy-btn text-red-400 hover:text-red-600 font-bold" data-index="${index}">&times;</button>
                            </span>`;
                    });
                }
            }
            
            function renderGrowthLog(pet) {
                const logContainer = document.getElementById('growth-log-list');
                const noRecordsMsg = document.getElementById('no-growth-message');
                if (!logContainer) return; // Add guard clause
                logContainer.innerHTML = '';

                if (!pet.growth || pet.growth.length === 0) {
                    noRecordsMsg.classList.remove('hidden');
                    logContainer.classList.add('hidden');
                } else {
                    // Sort entries by date, descending (newest first)
                    const sortedGrowth = [...pet.growth].sort((a, b) => new Date(b.date) - new Date(a.date));

                    noRecordsMsg.classList.add('hidden');
                    logContainer.classList.remove('hidden');
                    
                    sortedGrowth.forEach((g) => {
                        // Find the original index before sorting for editing/deleting
                        const originalIndex = pet.growth.findIndex(item => item.id === g.id);
                        const ageAtEntry = calculateAgeAtDate(pet.dob, g.date);
                        
                        const entryCard = `
                        <div class="bg-white border border-slate-200 rounded-lg p-4 flex flex-col sm:flex-row items-start sm:items-center gap-4 hover:bg-slate-50 transition-colors">
                            <img src="${g.photo || 'https://placehold.co/64x64/e2e8f0/94a3b8?text=Pet'}" alt="Growth photo" class="w-16 h-16 rounded-lg object-cover border-2 border-slate-200 flex-shrink-0">
                            
                            <div class="flex-grow grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-2 text-sm w-full">
                                <div>
                                    <span class="font-semibold text-slate-800">${g.date}</span>
                                    <span class="block text-slate-500">${ageAtEntry} old</span>
                                </div>
                                <div>
                                    <span class="font-semibold text-slate-800">${g.weight_kg || 'N/A'} kg</span>
                                    <span class="block text-slate-500">Weight</span>
                                </div>
                                <div>
                                    <span class="font-semibold text-slate-800">${g.height_cm || 'N/A'} cm</span>
                                    <span class="block text-slate-500">Height</span>
                                </div>
                                <div class="col-span-2 sm:col-span-4">
                                    <p class="text-slate-600">${g.notes || 'No notes'}</p>
                                </div>
                            </div>

                            <div class="flex-shrink-0 flex sm:flex-col gap-2 w-full sm:w-auto mt-3 sm:mt-0">
                                <button class="edit-growth-btn w-full sm:w-auto text-left sm:text-right text-xs font-medium text-blue-600 hover:underline" data-index="${originalIndex}">Edit</button>
                                <button class="delete-growth-btn w-full sm:w-auto text-left sm:text-right text-xs font-medium text-red-600 hover:underline" data-index="${originalIndex}">Delete</button>
                            </div>
                        </div>
                        `;
                        logContainer.innerHTML += entryCard;
                    });
                }
            }

            function renderGrowthChart(pet) {
                const ctx = document.getElementById('growth-chart');
                if (!ctx) return;

                if (growthChartInstance) {
                    growthChartInstance.destroy();
                }

                if (!pet.growth || pet.growth.length === 0) {
                    // Maybe show a message on the canvas? For now, just return.
                    return;
                }

                // Sort data by date, ascending
                const sortedData = [...pet.growth].sort((a, b) => new Date(a.date) - new Date(b.date));

                const labels = sortedData.map(g => g.date);
                const weightData = sortedData.map(g => g.weight_kg);
                const heightData = sortedData.map(g => g.height_cm);

                growthChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Weight (kg)',
                                data: weightData,
                                borderColor: '#3b82f6', // blue-500
                                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                fill: true,
                                yAxisID: 'yWeight',
                                tension: 0.3
                            },
                            {
                                label: 'Height (cm)',
                                data: heightData,
                                borderColor: '#8b5cf6', // purple-500
                                backgroundColor: 'rgba(139, 92, 246, 0.1)',
                                fill: false,
                                yAxisID: 'yHeight',
                                tension: 0.3,
                                borderDash: [5, 5]
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            x: {
                                title: { display: true, text: 'Date' }
                            },
                            yWeight: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Weight (kg)', color: '#3b82f6' }
                            },
                            yHeight: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: { display: true, text: 'Height (cm)', color: '#8b5cf6' },
                                grid: { drawOnChartArea: false } // only draw grid for weight
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed.y !== null) {
                                            label += context.parsed.y;
                                            if (context.dataset.yAxisID === 'yWeight') label += ' kg';
                                            if (context.dataset.yAxisID === 'yHeight') label += ' cm';
                                        }
                                        return label;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function resetGrowthForm() {
                const form = document.getElementById('add-growth-form');
                if (form) form.reset();
                const editingIndex = document.getElementById('editing-growth-index');
                if (editingIndex) editingIndex.value = '';
                const formTitle = document.getElementById('growth-form-title');
                if (formTitle) formTitle.textContent = 'Add New Growth Entry';
                const preview = document.getElementById('growth-photo-preview');
                if (preview) preview.src = 'https://placehold.co/64x64/e2e8f0/94a3b8?text=Photo';
                const photoInput = document.getElementById('new-growth-photo');
                if (photoInput) photoInput.value = ''; // Reset file input
            }

            // --- New Reminder Functions ---
            
            // Helper to get emoji icon
            function getReminderIcon(type) {
                const icons = {
                    'Vet': '💉',
                    'Grooming': '✂️',
                    'Medication': '💊',
                    'Feeding': '🍖',
                    'Walk': '🦮',
                    'Growth': '🌱',
                    'Other': '🔔'
                };
                return icons[type] || icons['Other'];
            }

            // Helper to get status (and check for missed)
            function getReminderStatus(reminder) {
                const today = new Date();
                today.setHours(0, 0, 0, 0); // Set to start of today
                
                // Combine date and time for accurate comparison
                const reminderDateTime = new Date(`${reminder.date}T${reminder.time || '00:00:00'}`);

                if (reminder.status === 'completed') {
                    return { text: 'Completed', classes: 'bg-green-100 text-green-800' };
                }
                if (reminderDateTime < today && reminder.status === 'pending') {
                    // Update status to missed if it's in the past and not done
                    reminder.status = 'missed';
                    savePets(); // Auto-update status in storage
                    return { text: 'Missed', classes: 'bg-red-100 text-red-800' };
                }
                if (reminder.status === 'missed') {
                     return { text: 'Missed', classes: 'bg-red-100 text-red-800' };
                }
                return { text: 'Pending', classes: 'bg-blue-100 text-blue-800' };
            }

            function renderReminders(pet) {
                const listContainer = document.getElementById('reminders-list-container');
                const noRecordsMsg = document.getElementById('no-reminders-message');
                if (!listContainer || !noRecordsMsg) return;
                
                listContainer.innerHTML = '';
                if (!pet.reminders) pet.reminders = [];

                // 1. Filter reminders
                const filteredReminders = pet.reminders.filter(r => {
                    const statusInfo = getReminderStatus(r); // This also updates missed status
                    const status = statusInfo.text; // 'Pending', 'Completed', 'Missed'
                    
                    if (currentReminderFilter === 'All') return true;
                    if (currentReminderFilter === 'Upcoming') return status === 'Pending';
                    if (currentReminderFilter === 'Completed') return status === 'Completed';
                    if (currentReminderFilter === 'Missed') return status === 'Missed';
                    return true;
                });

                // 2. Sort reminders by date (upcoming first)
                filteredReminders.sort((a, b) => new Date(a.date) - new Date(b.date));

                // 3. Render
                if (filteredReminders.length === 0) {
                    noRecordsMsg.classList.remove('hidden');
                    let emptyMsg = 'No reminders here.';
                    if (currentReminderFilter === 'Upcoming') emptyMsg = 'No upcoming reminders!';
                    if (currentReminderFilter === 'Completed') emptyMsg = 'No completed reminders yet.';
                    if (currentReminderFilter === 'Missed') emptyMsg = 'No missed reminders.';
                    if (currentReminderFilter === 'All' && pet.reminders.length === 0) emptyMsg = 'No reminders set. Add one to get started!';
                    noRecordsMsg.innerHTML = `<span class="text-4xl mb-4 block">🗓️</span>${emptyMsg}`;
                } else {
                    noRecordsMsg.classList.add('hidden');
                    
                    // --- Add date logic for highlighting ---
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    const threeDaysFromNow = new Date(today);
                    threeDaysFromNow.setDate(today.getDate() + 3);
                    // --- End date logic ---

                    filteredReminders.forEach(r => {
                        const icon = getReminderIcon(r.type);
                        const status = getReminderStatus(r);
                        
                        // --- Add highlight logic ---
                        const reminderDateOnly = new Date(r.date + 'T00:00:00'); // Normalize date for comparison
                        let highlightClass = 'border-l-transparent'; // Default
                        if (status.text === 'Pending' && reminderDateOnly >= today && reminderDateOnly <= threeDaysFromNow) {
                            highlightClass = 'border-l-yellow-400'; // Highlight class for upcoming
                        }
                        // --- End highlight logic ---

                        // Format time for display (e.g., 14:30 -> 2:30 PM)
                        let displayTime = '';
                        if (r.time) {
                            let [hours, minutes] = r.time.split(':');
                            let ampm = hours >= 12 ? 'PM' : 'AM';
                            hours = hours % 12;
                            hours = hours ? hours : 12; // the hour '0' should be '12'
                            displayTime = `${hours}:${minutes} ${ampm}`;
                        }

                        const cardHTML = `
                        <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-start gap-4 transition-all hover:shadow-md border-l-4 ${highlightClass}">
                            <div class="flex-shrink-0 w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-xl">${icon}</div>
                            
                            <div class="flex-grow">
                                <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-1">
                                    <h4 class="text-lg font-bold text-slate-800">${r.title}</h4>
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full ${status.classes}">${status.text}</span>
                                </div>
                                <p class="text-sm font-medium text-blue-600 mb-2">${r.date} at ${displayTime} ${r.repeat !== 'None' ? `(${r.repeat})` : ''}</p>
                                <p class="text-sm text-slate-600">${r.notes || 'No notes.'}</p>
                            </div>

                            <div class="flex-shrink-0 flex flex-col sm:flex-row gap-2">
                                ${status.text !== 'Completed' ? `<button title="Mark Done" class="complete-reminder-btn text-slate-400 hover:text-green-500 p-2 rounded-full hover:bg-green-100" data-reminder-id="${r.id}">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                                </button>` : ''}
                                <button title="Edit" class="edit-reminder-btn text-slate-400 hover:text-blue-500 p-2 rounded-full hover:bg-blue-100" data-reminder-id="${r.id}">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg>
                                </button>
                                <button title="Delete" class="delete-reminder-btn text-slate-400 hover:text-red-500 p-2 rounded-full hover:bg-red-100" data-reminder-id="${r.id}">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                                </button>
                            </div>
                        </div>
                        `;
                        listContainer.innerHTML += cardHTML;
                    });
                }
            }
            // --- End New Reminder Functions ---

            function calculateAge(dob) {
                if(!dob) return 'Unknown';
                const birthDate = new Date(dob);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                return age;
            }

            function renderPets() {
                petListContainer.innerHTML = '';
                if (pets.length === 0) {
                    noPetsMessage.classList.remove('hidden');
                    petListContainer.classList.add('hidden');
                    addPetBtn.classList.add('hidden');
                } else {
                    noPetsMessage.classList.add('hidden');
                    petListContainer.classList.remove('hidden');
                    addPetBtn.classList.remove('hidden');
                    
                    pets.forEach(pet => {
                        const age = calculateAge(pet.dob);
                        const petCard = document.createElement('div');
                        petCard.className = "bg-white rounded-2xl shadow-lg overflow-hidden transform hover:-translate-y-2 transition-transform duration-300 cursor-pointer";
                        petCard.innerHTML = `
                            <div class="h-48 bg-slate-200">
                                <img src="${pet.photo}" alt="${pet.name}" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='https://placehold.co/600x400/e2e8f0/94a3b8?text=Pet';">
                            </div>
                            <div class="p-6">
                                <h3 class="text-2xl font-bold text-slate-800">${pet.name}</h3>
                                <p class="text-slate-500">${pet.breed}</p>
                                <div class="flex items-center justify-between text-sm mt-4 text-slate-600">
                                    <span class="bg-slate-100 rounded-full px-3 py-1">${pet.gender}</span>
                                    <span class="bg-slate-100 rounded-full px-3 py-1">${age} years old</span>
                                </div>
                            </div>
                        `;
                        petCard.addEventListener('click', () => showPetDetailView(pet.id));
                        petListContainer.appendChild(petCard);
                    });
                }
            }
            
            addPetBtn.addEventListener('click', showAddPetForm);
            addPetInitialBtn.addEventListener('click', showAddPetForm);
            cancelAddPetBtn.addEventListener('click', showDashboard);

            petPhotoInput.addEventListener('change', () => {
                const file = petPhotoInput.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        photoPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });

            addPetForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const newPet = {
                    id: Date.now(),
                    name: document.getElementById('pet-name').value,
                    breed: document.getElementById('pet-breed').value,
                    dob: document.getElementById('pet-dob').value,
                    gender: document.querySelector('input[name="pet-gender"]:checked').value,
                    photo: photoPreview.src,
                    health: { vaccinations: [], allergies: [], medications: [] },
                    growth: [],
                    reminders: [],
                    gallery: []
                };
                pets.push(newPet);
                savePets(); // Save data
                showDashboard();
            });

            // --- Notification Toast Logic ---
            function showToast(message) {
                const toast = document.getElementById('notification-toast');
                const toastMessage = document.getElementById('toast-message');
                if (!toast || !toastMessage) return;

                toastMessage.textContent = message;
                
                // Clear any existing timeout
                if (toastTimeout) {
                    clearTimeout(toastTimeout);
                }

                // Show toast
                toast.classList.remove('translate-x-full');
                toast.classList.add('translate-x-0');

                // Hide toast after 3 seconds
                toastTimeout = setTimeout(() => {
                    toast.classList.remove('translate-x-0');
                    toast.classList.add('translate-x-full');
                    toastTimeout = null;
                }, 3000);
            }

            // --- Initial Load ---
            showDashboard();

        });
    </script>
</body>
